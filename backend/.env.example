# Copy to .env and adjust. Never commit the real .env.
PORT=4000
MONGODB_URI=mongodb://localhost:27017/support_portal
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
SESSION_TTL_HOURS=8
# Set to true when served over HTTPS
COOKIE_SECURE=false
